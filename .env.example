# Supabase Public Configuration (Safe for frontend exposure via NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Server-Only Secret (NEVER expose to client code / browser)
# Used exclusively in secure server-side routes, background workers, and admin sync
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Company Operating Mode
NEXT_PUBLIC_COMPANY_NAME="Aurtwiz Technologies"
NEXT_PUBLIC_PLATFORM_NAME="AURTWIZ BUSINESS OS"
NEXT_PUBLIC_APP_ENV="development"

# Security & Session Settings
AUTH_SESSION_COOKIE_NAME="aurtwiz_os_session"
AUTH_SESSION_EXPIRY_DAYS=7

